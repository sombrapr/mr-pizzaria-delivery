PORT=3000
NODE_ENV=production

# Senha usada pelo painel administrativo.
ADMIN_API_KEY=troque-por-uma-senha-forte

# Chave usada pelo conector da impressora.
PRINT_API_KEY=troque-por-outra-chave-forte

# Chave usada pelo robô do WhatsApp ao enviar pedidos prontos ao sistema.
WHATSAPP_INTERNAL_KEY=troque-por-uma-terceira-chave

# Arquivo do banco local. No Render, use /var/data/mr-delivery.json com disco persistente.
DATA_FILE=./data/mr-delivery.json

# Dados atuais da MR Pizzaria.
STORE_NAME=MR Pizzaria
STORE_PHONE=4434252285
STORE_ADDRESS=Av. Paraná, 897, Centro, Loanda - PR
